# Normalize line endings for text files
* text=auto

# ---------- Unity YAML / source text: force LF for stable diffs ----------
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.overridecontroller text eol=lf
*.physicmaterial text eol=lf
*.physicsmaterial2d text eol=lf
*.playable text eol=lf
*.mixer text eol=lf
*.mask text eol=lf
*.spriteatlas text eol=lf
*.preset text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.asmdef text eol=lf
*.cs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xaml text eol=lf

